# Test Database Configuration
# PostgreSQL database for testing environments
# Separate from development/production databases

# Database connection
DATABASE_TEST_URL="postgresql://test_user:test_password@localhost:5432/granja_test"

# JWT secrets for testing (use different secrets than production)
JWT_TEST_SECRET="test-jwt-secret-key-for-testing-only"
JWT_TEST_EXPIRES_IN="1h"

# Test environment settings
NODE_ENV="test"

# Disable external services in tests
DISABLE_EMAIL_SERVICE="true"
DISABLE_EXTERNAL_APIS="true"

# Redis configuration (optional for testing)
REDIS_TEST_URL="redis://localhost:6379/1"

# Test-specific settings
BCRYPT_SALT_ROUNDS="10"